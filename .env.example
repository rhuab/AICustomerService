# Letta (create agent once with create_agent.py, then set LETTA_AGENT_ID)
LETTA_API_KEY=
LETTA_AGENT_ID=

# OpenAI (embedding + optional intent/LLM)
OPENAI_API_KEY=

# PostgreSQL with pgvector
DATABASE_URL=postgresql://user:password@localhost:5432/hr_rag

# RAG (optional, defaults in config)
# RAG_TOP_K=5
# RAG_SIMILARITY_THRESHOLD=0.7

# Debug
# DEBUG_RAG=false
# LOG_LEVEL=INFO
# DEBUG_RESPONSE_INCLUDE_CONTEXT=false

# Web server
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
ADMIN_API_KEY=self-defined-api-key
